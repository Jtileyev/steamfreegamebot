[Unit]
Description=Steam Deals Telegram Bot
After=network.target

[Service]
Type=simple
User=steam-bot
WorkingDirectory=/var/www/steamfreegamebot
EnvironmentFile=/var/www/steamfreegamebot/.env
ExecStart=/var/www/steamfreegamebot/venv/bin/python3 clock.py
Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target
