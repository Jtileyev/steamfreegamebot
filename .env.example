# SQLite (путь к файлу базы данных, считается от рабочей директории)
DATABASE_PATH=data/steam_bot.db

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Регион магазина Steam. Выберите один раз: база отправленных привязана к региону
STEAM_CC=kz

# Пороги отбора
# Минимальная скидка в процентах: 70 = уведомлять о скидках -70% и выше
MIN_DISCOUNT_PERCENT=70
# Минимальная доля положительных отзывов, процентов
MIN_REVIEW_PCT=80
# Минимальное число отзывов
MIN_REVIEWS=200

# Исключаемые теги Steam через запятую, none отключает исключение. По умолчанию:
# Visual Novel, Anime, Sexual Content, Hentai, Nudity
EXCLUDE_TAG_IDS=3799,4085,12095,9130,6650

# Страниц поиска по 100 строк за цикл, пауза между ними 12 секунд.
# Выдача отсортирована по отзывам: 1 страница это лучшие ~4% скидок,
# при порогах по умолчанию все подходящие скидки помещаются в 10 страниц
STEAM_MAX_PAGES=1

# Разумный диапазон total_count в ответе Steam, сейчас около 2500. Выход за него
# считается ошибкой источника: пустой ответ или проигнорирован фильтр specials
STEAM_TOTAL_COUNT_MIN=50
STEAM_TOTAL_COUNT_MAX=12000

# Интервал проверки, часов
CHECK_INTERVAL_HOURS=12
# Не больше стольких уведомлений за цикл, остаток переносится на следующий
MAX_MESSAGES_PER_CYCLE=10
# Через сколько дней отсутствия в выдаче скидка забывается. Дольше интервала проверки
FORGET_AFTER_DAYS=3
# Предупредить в Telegram, если успешной проверки не было столько часов
HEARTBEAT_HOURS=24
