# PostgreSQL (Neon)
# Получите connection string на https://neon.tech
DATABASE_URL=postgresql://username:password@ep-xxx-xxx-123456.us-east-2.aws.neon.tech/dbname?sslmode=require

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Настройки скидок
# Минимальный порог скидки для уведомления (в процентах)
# 70 = уведомлять о скидках -70% и выше
# 50 = уведомлять о скидках -50% и выше
MIN_DISCOUNT_PERCENT=70
